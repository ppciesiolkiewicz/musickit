        "heading": "Lip roll",
        "minutes": 3,
        "cells": [
          {
            "type": "text",
            "text": "Start the lip roll below: a tone slides from head voice down to chest voice, then you make the same slide on your own while the mic draws your line. Sing it on a lip roll, loose and quiet.\nEach round goes a little lower. Let the buzz stay even through the places where your voice wants to flip."
          },
          {
            "type": "tool",
            "tool": {
              "type": "lip-roll",
              "shape": "down",
              "voice": "baritone",
              "plays": 4
            }
