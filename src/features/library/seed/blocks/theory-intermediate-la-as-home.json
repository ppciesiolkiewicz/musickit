        "minutes": 2,
        "cells": [
          {
            "type": "text",
            "text": "Tap from the low {{6}} up to {{3}} on the staff below, and come back down to {{6}}. Then press Play under the staff to start the drone on La, and tap the same line against it.\nKeep going until La sounds like the note the line has to end on."
          },
          {
            "type": "tool",
            "tool": {
