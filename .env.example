# Sampler (Vercel -> Settings -> Environment Variables). Both are needed for the site's own key to be used.
# SAMPLER_SITE_PASSWORD is one password for the whole site (old name SAMPLER_ACCESS_CODE still works). Each provider adds its own <PROVIDER>_API_KEY.
ELEVENLABS_API_KEY=
SAMPLER_SITE_PASSWORD=

# Private cloud library of NAM amp models (Vercel Blob, access private). The routes in src/app/api/nam use these.
# Optional: NAM_LIBRARY_PASSWORD gates the cloud NAM library. Unset = open.
MUSICKIT_BLOB_READ_WRITE_TOKEN=

# Contact form (/api/contact). Messages are emailed via Resend and also saved as private blobs under contact/ (needs the blob token above).
# Either one is enough. The default sender hello@attunr.app needs the attunr.app domain verified in Resend (Domains).
# Until then set CONTACT_FROM_EMAIL="attunr contact <onboarding@resend.dev>", which only delivers to your Resend account's email.
RESEND_API_KEY=
# Optional. Defaults: CONTACT_TO_EMAIL=attunrapp@gmail.com, CONTACT_FROM_EMAIL="attunr <hello@attunr.app>"
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
