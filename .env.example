# Sampler (Vercel -> Settings -> Environment Variables). Both are needed for the site's own key to be used.
# SAMPLER_SITE_PASSWORD is one password for the whole site (old name SAMPLER_ACCESS_CODE still works). Each provider adds its own <PROVIDER>_API_KEY.
ELEVENLABS_API_KEY=
SAMPLER_SITE_PASSWORD=

# Private cloud library of NAM amp models (Vercel Blob, access private). The routes in src/app/api/nam use these.
# Optional: NAM_LIBRARY_PASSWORD gates the cloud NAM library. Unset = open.
MUSICKIT_BLOB_READ_WRITE_TOKEN=
