# Settings for the e2e test server (playwright.config.ts). Values here win over .env and .env.local.
# Its own database in the local Docker Postgres (musickit-db, port 5433), never the dev or release one.
# Create it once: docker exec musickit-db psql -U musickit -d musickit -c "create database musickit_e2e"
DATABASE_URL=postgres://musickit:musickit@127.0.0.1:5433/musickit_e2e

# No analytics from test runs (.env.local has the real keys).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
